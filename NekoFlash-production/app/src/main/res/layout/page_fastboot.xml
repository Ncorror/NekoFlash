<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerFastboot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Тонкая кнопка вызова терминала (отдельный цвет) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFastbootTerminal"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="9dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/layout_fastboot_terminal"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            app:backgroundTint="@color/bg_elevated"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_terminal_keyboard"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/accent"
            app:strokeColor="#806A4428"
            app:strokeWidth="1dp" />

        <!-- Recovery-first Quick Flash: one image, one concrete target, one confirmation -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickFlashRecoveryFirst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/quick_flash_recovery_first_title"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/quick_flash_recovery_first_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBlockImportFastboot"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        app:icon="@drawable/ic_nf_import"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="@null"
                        app:backgroundTint="@color/bg_elevated"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlashRecovery"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/quick_flash_primary_recovery"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    app:backgroundTint="#263A20"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_nf_recovery_green"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="24dp"
                    app:iconTint="@null"
                    app:strokeColor="#4E7A43"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/quick_flash_other_targets"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.PartitionTile"
                        android:id="@+id/btnFlashBoot"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/layout_partition_boot"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.PartitionTile"
                        android:id="@+id/btnFlashInitBoot"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/layout_partition_init_boot"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.PartitionTile"
                        android:id="@+id/btnFlashVendorBoot"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/layout_partition_vendor_boot"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerQuickFlashExpertTargets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.NekoFlash.PartitionTile"
                            android:id="@+id/btnFlashDtbo"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/layout_partition_dtbo"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.NekoFlash.PartitionTile"
                            android:id="@+id/btnFlashVbmeta"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/layout_partition_vbmeta"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.NekoFlash.PartitionTile"
                            android:id="@+id/btnFlashVendorKernelBoot"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/layout_partition_vendor_kernel_boot"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlashManual"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/quick_flash_manual_target"
                        android:textAllCaps="false"
                        android:textColor="#F2C98B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        app:backgroundTint="#2A2115"
                        app:cornerRadius="12dp"
                        app:strokeColor="#6C522C"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlashRebootMode"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/layout_flash_reboot_mode"
                    android:textAllCaps="false"
                    android:textColor="#F97316"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    app:backgroundTint="#2A1C10"
                    app:strokeColor="#5A3A1E"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<!-- Очередь прошивки (без vbmeta) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/legacyFlashQueueCard"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/layout_flash_queue_title"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:fontFamily="monospace" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBlockImportQueue"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        app:icon="@drawable/ic_nf_import"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="@null"
                        app:backgroundTint="@color/bg_elevated"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Кнопки добавления в очередь 3×2 (без vbmeta) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.QueueTile"
                        android:id="@+id/btnQueueBoot"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/layout_add_boot"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.QueueTile"
                        android:id="@+id/btnQueueInitBoot"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="@string/layout_add_init_boot"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.QueueTile"
                        android:id="@+id/btnQueueRecovery"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="@string/layout_add_recovery"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.QueueTile"
                        android:id="@+id/btnQueueVendorBoot"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/layout_add_vendor_boot"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.QueueTile"
                        android:id="@+id/btnQueueDtbo"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="@string/layout_add_dtbo"
                        android:textSize="11sp" />

                    <!-- Распорка для выравнивания сетки 3×2 (раздел vbmeta удалён) -->
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp" />
                </LinearLayout>

                <!-- Резюме очереди -->
                <TextView
                    android:id="@+id/tvFlashQueueSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/bg_console"
                    android:padding="8dp"
                    android:text="@string/layout_queue_empty_short"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <!-- Запустить / Очистить -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQueueStart"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="2"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/layout_start_queue"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#3A210D"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.SecondaryAction"
                        android:id="@+id/btnQueueClear"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/layout_clear"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>
</ScrollView>
