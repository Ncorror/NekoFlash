<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Объявление host-режима USB. Платформа требует его от приложений,
        работающих с USB Host API, и без него часть систем не доставляет
        USB_DEVICE_ATTACHED и не показывает устройства в getDeviceList.

        required="false" намеренно: при "true" установка блокируется на любом
        аппарате, который о фиче не сообщает, даже если OTG у него работает.
        Наличие фичи проверяется на месте и попадает в evidence, а не решает
        за пользователя, можно ли поставить приложение.
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".NekoFlashApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NekoFlash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Система доставляет attach именно активности, поэтому фильтр
                живёт здесь, а не в модуле usb:android.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
